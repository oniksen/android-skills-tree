# Copy to `.env.local` and fill in the values.
# `.env.local` is gitignored and must never be committed.

# --- Server-only secrets ---
# Used to sign the session cookie (at least 32 characters).
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# --- Firebase Admin (server-authoritative writes) ---
# Service-account credentials. Generate a key in Firebase console:
# Project settings > Service accounts > Generate new private key.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Firebase web configuration (public) ---
# These values are embedded in the client bundle and are not secrets.
# Find them in the Firebase console: Project settings > General > Web apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
